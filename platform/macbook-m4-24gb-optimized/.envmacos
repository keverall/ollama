#============================================================================
# Platform Environment Template — MacBook M4 Pro 24GB
# Copy this file to .env and customize for your system
#============================================================================
# Purpose: Configure Ollama for Apple Silicon unified memory
#
# After cloning, run:
#   cp .envexample .env
#   # Edit .env to match your Ollama installation path
#
# Variables control:
#   - Model selection (which models to ensure at startup)
#   - GPU optimizations (flash attention, KV cache)
#   - Storage location (where model weights are stored)
#   - Network binding (which interfaces Ollama listens on)
#============================================================================
# Models to ensure are present and ready
# export FULL_MODEL_LIST="nomic-embed-text,qwen2.5-coder:7b,qwen2.5-coder:3b,llama3.1:8b"
export MODEL_LIST="nomic-embed-text,qwen2.5-coder:3b,llama3.1:8b"
export DEVOPS_MODEL="illama3-devops"
export QUICK_MODEL="qwen-quick"
export OLLAMA_BIN="/usr/local/bin/ollama"
export OLLAMA_MODELS=~/.ollama/models/ 

# Memory optimizations for M4 Pro 24GB
export OLLAMA_FLASH_ATTENTION=1
export OLLAMA_KV_CACHE_TYPE=q4_0
export OLLAMA_NUM_PARALLEL=8
export OLLAMA_MAX_LOADED_MODELS=1

export OLLAMA_HOST="[::]:11434" # Forces IPv6 + IPv4 dual-stack

